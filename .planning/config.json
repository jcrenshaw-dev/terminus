{
  "granularity": "standard",
  "model": {
    "escalate_on_failure": false
  },
  "workflow": {
    "research": false,
    "plan_check": false,
    "verifier": true,
    "skip_discuss": false,
    "inline_plan_threshold": 3,
    "max_plan_tasks": 8,
    "test_command": null,
    "lint_command": null
  },
  "parallelization": {
    "enabled": true,
    "max_concurrent_agents": 3,
    "min_plans_for_parallel": 2,
    "use_worktrees": true
  },
  "git": {
    "protected_branches": [
      "main",
      "master"
    ],
    "on_protected": "ask",
    "integration_branch": "milestone",
    "auto_branch": "ask",
    "base_branch": null,
    "create_tag": true,
    "on_land_cleanup": true,
    "issue_check": true,
    "forge_provider": "github",
    "forge_repo": "jcrenshaw-dev/terminus",
    "forge_host": null
  },
  "planning": {
    "commit_docs": true
  },
  "memory": {
    "backend": "builtin"
  },
  "review": {
    "mode": "adjudicated",
    "key_file": null,
    "providers": {
      "openai": {
        "tiers": {}
      },
      "gemini": {
        "tiers": {
          "flagship": null,
          "balanced": null,
          "cheap": null
        }
      },
      "deepseek": {
        "tiers": {
          "flagship": null,
          "balanced": null,
          "cheap": null
        }
      }
    },
    "consult": {
      "enabled": false,
      "tier": "flagship",
      "effort": "high",
      "attempt_threshold": 3
    },
    "decision_review": {
      "tier": "flagship",
      "effort": "high"
    }
  }
}
